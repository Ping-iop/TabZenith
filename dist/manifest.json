{
  "manifest_version": 3,
  "name": "TabZenith - Gestor Inteligente & Dashboard Gerencial AI",
  "version": "1.0.8",
  "description": "TabZenith: Guarda, agrupa, clasifica con Laya Core en CPU y congela pestañas para optimizar RAM con panel de curaduría de enlaces.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "assets/*",
        "icons/*"
      ],
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabFlow - Gestor Rápido",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Abrir popup de TabFlow"
    }
  }
}
